{
  "name": "label-byte-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-local encoding diagnostics and reversible repair workspace for pharmaceutical label archives",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "samples:regen": "python3 scripts/generate-samples.py"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
